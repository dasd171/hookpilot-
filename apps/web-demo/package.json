{
  "name": "@hookpilot/web-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HookPilot interactive web demo - SIMULATION ONLY (synthetic data, no hardware).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "python3 ../../tools/gen_web_fixtures.py",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
